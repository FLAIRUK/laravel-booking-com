{
    "name": "flairuk/laravel-booking-com",
    "description": "A Laravel client for the Booking.com Demand API: search, availability, property content, orders and car rentals.",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "booking.com", "booking", "demand-api", "hotels", "accommodation", "travel", "affiliate", "api-client"],
    "homepage": "https://github.com/FLAIRUK/laravel-booking-com",
    "authors": [
        {
            "name": "Phil Graham",
            "homepage": "https://github.com/ijeffro",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/cache": "^12.0|^13.0",
        "illuminate/collections": "^12.0|^13.0",
        "illuminate/console": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0"
    },
    "require-dev": {
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^11.5|^12.0|^13.0"
    },
    "autoload": {
        "psr-4": {
            "FLAIRUK\\BookingCom\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "FLAIRUK\\BookingCom\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "format": "pint"
    },
    "extra": {
        "laravel": {
            "providers": [
                "FLAIRUK\\BookingCom\\BookingComServiceProvider"
            ],
            "aliases": {
                "BookingCom": "FLAIRUK\\BookingCom\\Facades\\BookingCom"
            }
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "support": {
        "source": "https://github.com/FLAIRUK/laravel-booking-com",
        "issues": "https://github.com/FLAIRUK/laravel-booking-com/issues"
    }
}
